# Databricks API Configuration
# Copy this file to .env and fill in your credentials

# Your Databricks Personal Access Token
# Generate at: Databricks Workspace > User Settings > Developer > Access Tokens
DATABRICKS_API_TOKEN=your_databricks_personal_access_token_here

# Databricks Model Serving Endpoint URL
# Replace with your actual endpoint URL
DATABRICKS_ENDPOINT_URL=https://dbc-32cf6ae7-cf82.staging.cloud.databricks.com/serving-endpoints/databricks-gpt-oss-120b/invocations

# Server Configuration (optional - defaults shown)
PORT=8000
HOST=0.0.0.0
